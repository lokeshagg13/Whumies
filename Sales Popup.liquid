{% comment %}
  Whumies – Sales Notification Popup (Eurus)
  - Random delay between min/max seconds
  - Shows for display_duration seconds then hides
  - Randomly picks: customer name, city, product (from chosen collection)
  - Click popup → go to product URL
{% endcomment %}

{% assign products_array = '' %}
{% if section.settings.source_collection != blank and collections[section.settings.source_collection] %}
  {% assign coll = collections[section.settings.source_collection] %}
{% endif %}

<div id="whu-sales-pop" class="whu-sales-pop" aria-live="polite" aria-hidden="true">
  <button class="whu-close" type="button" aria-label="Close notification">×</button>
  <a class="whu-link" href="#" rel="nofollow">
    <img class="whu-img" alt="" loading="lazy" />
    <div class="whu-text">
      <span class="whu-line">
        <span class="whu-name">&nbsp;</span>
        <span>&nbsp;from&nbsp;</span>
        <span class="whu-city">&nbsp;</span>
      </span>
      <span class="whu-line">
        <span>recently purchased&nbsp;</span>
        <strong class="whu-product">&nbsp;</strong>
      </span>
    </div>
  </a>
</div>

<style>
  .whu-sales-pop{
    position: fixed; left: 16px; bottom: 16px; z-index: 9999;
    display: none; align-items: center; gap: 12px;
    background: #ffffff; color:#222; border: 1px solid rgba(0,0,0,.08);
    border-radius: 12px; box-shadow: 0 10px 20px rgba(0,0,0,.12);
    padding: 10px 14px 10px 10px; max-width: 320px;
    font: 500 14px/1.35 system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
  }
  .whu-sales-pop a.whu-link{ display: flex; align-items: center; gap: 12px; text-decoration: none; color: inherit; }
  .whu-img{
    width: 56px; height: 56px; border-radius: 8px; object-fit: cover; flex: 0 0 56px;
    background: #f5f5f5;
  }
  .whu-text{ display: flex; flex-direction: column; }
  .whu-line{ white-space: normal; display: block; }
  .whu-name, .whu-city{ font-weight: 600; }
  .whu-product{ font-weight: 700; }
  .whu-close{
    appearance:none; border:0; background:transparent; color:#666;
    position:absolute; top:6px; right:8px; font-size:18px; line-height:1;
    cursor:pointer; padding:4px;
  }

  @media (max-width: 480px){
    .whu-sales-pop{ left: 10px; right: 10px; bottom: 12px; max-width: unset; }
    .whu-img{ width: 48px; height: 48px; }
  }
</style>

<script>
(function(){
  // ===== Config from settings =====
  var ENABLED = {{ section.settings.enable | json }};
  if(!ENABLED) return;

  var MIN_DELAY = ({{ section.settings.min_delay | default: 40 | json }}) * 1000;   // seconds → ms
  var MAX_DELAY = ({{ section.settings.max_delay | default: 180 | json }}) * 1000;  // seconds → ms
  var SHOW_TIME = ({{ section.settings.display_duration | default: 10 | json }}) * 1000;
  
  // Customer names & cities list (newline-separated in settings)
  var NAMES = {{ section.settings.customer_names | json }}.split('\n').map(name => name.trim()).filter(name => name !== '');
  var CITIES = {{ section.settings.city_names | json }}.split('\n').map(city => city.trim()).filter(city => city !== '');
  
  // Build products array from selected collection (server-side Liquid → JS)
  var PRODUCTS = [
    {% if coll and coll.products_count > 0 %}
      {% for p in coll.products limit: 50 %}
        {
          "title": {{ p.title | json }},
          "url": {{ p.url | json }},
          "image": {% if p.featured_media %}{{ p.featured_media | image_url: width: 200, height: 200, crop: "center" | json }}{% else %}null{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    {% endif %}
  ];
  
  // If merchant specified explicit product overrides, merge them in
  var OVERRIDE_PRODUCTS = [
    {% for block in section.blocks %}
      {% if block.type == 'product' and all_products[block.settings.prod] %}
        {% assign bp = all_products[block.settings.prod] %}
        {
          "title": {{ bp.title | json }},
          "url": {{ bp.url | json }},
          "image": {% if bp.featured_media %}{{ bp.featured_media | image_url: width: 200, height: 200, crop: "center" | json }}{% else %}null{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {% endif %}
    {% endfor %}
  ];
  
  if (OVERRIDE_PRODUCTS.length) {
    // prepend overrides so they get used more often
    PRODUCTS = OVERRIDE_PRODUCTS.concat(PRODUCTS);
  }

  // Guards
  if (!PRODUCTS.length || !NAMES.length || !CITIES.length) return;
  
  // DOM refs
  var root = document.getElementById('whu-sales-pop');
  var img  = root.querySelector('.whu-img');
  var nameEl = root.querySelector('.whu-name');
  var cityEl = root.querySelector('.whu-city');
  var prodEl = root.querySelector('.whu-product');
  var linkEl = root.querySelector('.whu-link');
  var closeBtn = root.querySelector('.whu-close');

  function randBetween(min, max){
    return Math.floor(Math.random() * (max - min + 1)) + min;
  }
  function pick(arr){ return arr[randBetween(0, arr.length - 1)]; }

  function firstNameOnly(full){
    var parts = String(full).trim().split(/\s+/);
    if (!parts.length) return full;
    var first = parts[0];
    var lastInitial = parts.length > 1 ? (" " + parts[1].charAt(0).toUpperCase() + ".") : "";
    return first + lastInitial;
  }

  function showOnce(){
    // choose random combo
    var chosenName = firstNameOnly(pick(NAMES));
    var chosenCity = pick(CITIES);
    var product = pick(PRODUCTS);
    console.log(chosenName, chosenCity, product)
    nameEl.textContent = chosenName;
    cityEl.textContent = chosenCity;
    prodEl.textContent = product.title;
    linkEl.setAttribute('href', product.url);
    if (product.image){
      img.src = product.image;
      img.alt = product.title;
    }

    root.style.display = 'flex';
    root.setAttribute('aria-hidden', 'false');

    // auto-hide
    setTimeout(function(){
      root.style.display = 'none';
      root.setAttribute('aria-hidden', 'true');
      // schedule next cycle
      scheduleNext();
    }, SHOW_TIME);
  }

  function scheduleNext(){
    var delay = randBetween(MIN_DELAY, MAX_DELAY);
    console.log(delay)
    setTimeout(showOnce, delay);
  }

  // Manual close
  closeBtn.addEventListener('click', function(e){
    e.stopPropagation();
    root.style.display = 'none';
    root.setAttribute('aria-hidden', 'true');
    // still schedule next
    scheduleNext();
  });

  // Start the loop after an initial random delay
  scheduleNext();

})();
</script>

{% schema %}
{
  "name": "Sales Notification Popup",
  "tag": "section",
  "class": "whumies-sales-popup",
  "settings": [
    { "type": "checkbox", "id": "enable", "label": "Enable popup", "default": true },

    { "type": "collection", "id": "source_collection", "label": "Product collection (dynamic source)" },
    { "type": "paragraph", "content": "Optionally add specific products below; they’ll be prioritized." },

    { "type": "header", "content": "Timing" },
    { "type": "range", "id": "min_delay", "label": "Min delay (seconds)", "min": 10, "max": 300, "step": 10, "default": 40 },
    { "type": "range", "id": "max_delay", "label": "Max delay (seconds)", "min": 20, "max": 600, "step": 10, "default": 180 },
    { "type": "range", "id": "display_duration", "label": "Show for (seconds)", "min": 5, "max": 30, "step": 1, "default": 10 },

    { "type": "header", "content": "Customer Names (one per line)" },
    { "type": "textarea", "id": "customer_names", "label": "Names", "default": "Aarav Sharma\nDiya Kapoor\nIshaan Mehta\nMeera S.\nKabir A." },

    { "type": "header", "content": "City Names (one per line)" },
    { "type": "textarea", "id": "city_names", "label": "Cities", "default": "Delhi\nMumbai\nBengaluru\nHyderabad\nGurugram" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Specific product",
      "settings": [
        { "type": "product", "id": "prod", "label": "Product" }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [
    { "name": "Sales Notification Popup (Whumies)" }
  ]
}
{% endschema %}
